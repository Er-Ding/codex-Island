<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CodexIsland</AssemblyName>
    <RootNamespace>CodexIsland.Windows</RootNamespace>
    <!-- WPF owns the message loop and DPI manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexIsland.Core/CodexIsland.Core.csproj" />
  </ItemGroup>
</Project>
