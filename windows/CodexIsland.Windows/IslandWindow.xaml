<Window x:Class="CodexIsland.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Island" Width="224" Height="36" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Language="zh-CN" Foreground="#F0F2F4"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Mint" Color="#75E0B3" />
        <FontFamily x:Key="InterfaceFont">Segoe UI, Microsoft YaHei UI</FontFamily>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="#98A3AA" />
        </Style>
        <!-- Popups have their own visual tree: specify the complete type and surface styles. -->
        <Style x:Key="QuotaMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DCE4E7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Path x:Name="Check" Grid.Column="1" Data="M 1,6 L 5,10 L 12,2" Width="13" Height="12"
                                      Stroke="{StaticResource Mint}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#192F27" />
                                <Setter Property="Foreground" Value="#8CE9C3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#25342F" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuotaMenu" TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Language" Value="zh-CN" />
            <Setter Property="Foreground" Value="#DCE4E7" />
            <Setter Property="Background" Value="#111815" />
            <Setter Property="BorderBrush" Value="#33463D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Width" Value="276" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource QuotaMenuItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="额度类型" Style="{StaticResource Caption}" Margin="12,7,12,7" />
                                <ScrollViewer Grid.Row="1" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#A3AAAE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#20272B" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid><Border x:Name="PART_Track" Background="#25292C" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="QuotaCard">
            <Border Background="#121518" BorderBrush="#202529" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="42" /><RowDefinition Height="4" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding PeriodTitle}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding PercentText, Mode=OneWay}" Foreground="{Binding Accent}" FontSize="32" FontWeight="SemiBold" /><Run Text="  剩余" FontSize="12" Foreground="#98A3AA" />
                    </TextBlock>
                    <ProgressBar Grid.Row="2" Value="{Binding Remaining, Mode=OneWay}" Foreground="{Binding Accent}" Maximum="100" />
                    <TextBlock Grid.Row="3" Text="{Binding ResetLabel}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Canvas x:Name="HostCanvas">
        <Border x:Name="IslandSurface" Background="#080A0C" BorderBrush="#282D31" BorderThickness="1" CornerRadius="0,0,17,17">
            <Grid x:Name="LayoutRoot" Height="336" Width="224" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="300" /></Grid.RowDefinitions>
                <Button x:Name="HeaderButton" Click="HeaderClicked" ToolTip="点击固定或收起额度面板" AutomationProperties.Name="固定或收起额度面板">
                    <Grid x:Name="CompactHeader" Width="210">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="✦" Foreground="{StaticResource Mint}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="FirstPeriod" Foreground="#9DA5AB" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="FirstPercent" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="SecondPeriod" Foreground="#98A3AA" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="SecondPercent" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="6,0,0,0" />
                            <Ellipse x:Name="StaleDot" Width="4" Height="4" Fill="#FAB857" Margin="6,0,0,0" ToolTip="额度数据待更新" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Grid x:Name="AdjustmentHeader" Visibility="Collapsed" Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                    <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll"
                            MouseLeftButtonDown="DragStarted" MouseMove="DragMoved" MouseLeftButtonUp="DragEnded" LostMouseCapture="DragCaptureLost">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Mint}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="拖动调整位置" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="DoneButton" Grid.Column="1" Height="24" Content="完成" Foreground="#75E0B3" Background="#1C3229" FontSize="11" Click="DoneClicked" AutomationProperties.Name="完成并保存位置" />
                    <Button x:Name="CancelButton" Grid.Column="2" Content="×" FontSize="16" Click="CancelClicked" ToolTip="取消位置调整" AutomationProperties.Name="取消位置调整" />
                </Grid>
                <Grid x:Name="Details" Grid.Row="1" Width="420" Height="300" HorizontalAlignment="Center" Margin="0" Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="18,14,18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" /><RowDefinition Height="10" /><RowDefinition Height="132" />
                            <RowDefinition Height="10" /><RowDefinition Height="1" /><RowDefinition Height="10" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                            <Border Width="33" Height="33" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="9" Background="#152B22">
                                <TextBlock Text="✦" FontSize="20" Foreground="{StaticResource Mint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Button x:Name="BucketButton" Click="BucketClicked" HorizontalAlignment="Left" AutomationProperties.Name="切换额度种类">
                                    <DockPanel Width="236" Height="26">
                                        <Path x:Name="BucketArrow" DockPanel.Dock="Right" Data="M 1,1 L 5,5 L 9,1" Stroke="#98A3AA" StrokeThickness="1.4"
                                              Width="10" Height="6" Margin="8,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BucketTitle" Text="Codex" FontSize="20" FontWeight="SemiBold" Foreground="#F0F2F4" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                                <TextBlock Text="剩余额度" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2" Height="25" CornerRadius="12" Background="#1A1F23" VerticalAlignment="Top" Margin="0,4,0,0">
                                <TextBlock x:Name="PlanLabel" Text="账户额度" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ItemsControl x:Name="Cards" Grid.Row="2" ItemTemplate="{StaticResource QuotaCard}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Grid.Row="4" Background="#24292D" />
                        <Grid Grid.Row="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="122" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="4" Height="4" Fill="{StaticResource Mint}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="StatusTitle" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="#B0BABF" />
                                </StackPanel>
                                <TextBlock x:Name="ErrorLabel" Foreground="#FAB857" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,2,6,0" />
                                <TextBlock x:Name="LastUpdated" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="#86929A" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="MoveButton" Style="{StaticResource IconButton}" Content="&#xE8AB;" Click="MoveClicked" ToolTip="调整位置" AutomationProperties.Name="调整位置" />
                                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="RefreshClicked" ToolTip="立即刷新" AutomationProperties.Name="立即刷新额度" />
                                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" Click="PinClicked" ToolTip="固定面板" AutomationProperties.Name="固定面板" />
                                <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE70E;" Click="CollapseClicked" ToolTip="收起" AutomationProperties.Name="收起额度面板" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
